# Environment variables for ssm-phylo.
# Copy to .env and adjust. On Colab, put this file in $COLAB_DRIVE and the
# setup script sources it (and mirrors it to /content/ssm-phylo/.env).
#
# Golden rule: Drive = persistent, /content = scratch (wiped every session).
# All scripts read these via dotenv; every path is env-driven (no hardcoded paths).

COLAB_DRIVE=/content/drive/MyDrive/ssm-phylo
DATA_DIR=$COLAB_DRIVE/data
CKPT_DIR=$COLAB_DRIVE/checkpoints
RESULTS_DIR=$COLAB_DRIVE/results
PROT_MAMBA_CKPT=$COLAB_DRIVE/weights/protmamba

# Scratch (ephemeral VM disk) — checkpoints & data live here during a session.
LOCAL_CKPT_DIR=/content/ckpts
LOCAL_DATA_DIR=/content/data

# Local checkout of the Phyloformer repo (simulation + eval binaries). Set if
# running simulation outside Colab; empty on Colab (cloned during setup).
PHYLOFORMER_DIR=

# Optional: experiment tracking. Leave empty on Colab to skip wandb login.
WANDB_API_KEY=

# NOTE: no HF_REPO / HF_TOKEN needed — HuggingFace Hub is an optional Phase 7
# (publication mirror) concern, not part of the core pipeline.
